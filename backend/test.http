@baseUrl = http://localhost:5000/api

### --------------------------------------------------------
### STEP 1: GENERATE ACCOUNTS & TOKENS
### Run these registers first so they have properly hashed passwords.
### --------------------------------------------------------

### 1a. Register Test Customer
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "full_name": "Test Customer",
  "email": "testcustomer@gmail.com",
  "password": "password123",
  "role": "customer"
}

### 1b. Register Test Support Agent
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "full_name": "Test Support",
  "email": "testsupport@gmail.com",
  "password": "password123",
  "role": "support_agent"
}

### 1c. Register Test Admin
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "full_name": "Test Admin",
  "email": "testadmin@gmail.com",
  "password": "password123",
  "role": "admin"
}

### --------------------------------------------------------
### STEP 2: LOGIN TO GET TOKENS
### Execute these, copy the "token" string from the response, 
### and paste them into the variables directly below.
### --------------------------------------------------------

### 2a. Login Customer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "priya@gmail.com",
  "password": "123456"
}

### 2b. Login Support Agent
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "testsupport@gmail.com",
  "password": "password123"
}

### 2c. Login Admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "rahul@gmail.com",
  "password": "123456"
}

